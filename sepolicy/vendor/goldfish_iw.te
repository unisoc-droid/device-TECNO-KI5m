# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type goldfish_iw, domain, netdomain;
type goldfish_iw_exec, exec_type, file_type, vendor_file_type;

allow goldfish_iw goldfish_iw_exec:file { read getattr map execute open entrypoint };
