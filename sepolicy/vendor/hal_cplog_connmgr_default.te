# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type hal_cplog_connmgr_default, domain;
type hal_cplog_connmgr_default_exec, exec_type, file_type, vendor_file_type;

allow hal_cplog_connmgr_default hal_cplog_connmgr_default_exec:file { read getattr map execute open entrypoint };
