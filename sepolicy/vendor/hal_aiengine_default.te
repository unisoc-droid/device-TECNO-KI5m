# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type hal_aiengine_default, domain;
type hal_aiengine_default_exec, exec_type, file_type, vendor_file_type;

allow hal_aiengine_default hal_aiengine_default_exec:file { read getattr map execute open entrypoint };
allow hal_aiengine_default hal_aiengine_hwservice:hwservice_manager { add find };
allow hal_aiengine_default hidl_base_hwservice:hwservice_manager add;
allow hal_aiengine_default hwservicemanager:binder { call transfer };
allow hal_aiengine_default hwservicemanager_prop:file { read getattr map open };
allow hal_aiengine_default shell_data_file:file read;
allow hal_aiengine_default system_app:binder { call transfer };
allow hal_aiengine_default system_app:fd use;
