# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type sprd_coulomb_app, appdomain, domain, mlstrustedsubject, netdomain;
type sprd_coulomb_app_tmpfs, file_type;
type sprd_coulomb_app_userfaultfd;

allow sprd_coulomb_app activity_service:service_manager find;
allow sprd_coulomb_app appdomain_tmpfs:file { read write getattr map execute };
allow sprd_coulomb_app connectivity_service:service_manager find;
allow sprd_coulomb_app display_service:service_manager find;
allow sprd_coulomb_app dnsproxyd_socket:sock_file write;
allow sprd_coulomb_app mount_service:service_manager find;
allow sprd_coulomb_app netd:unix_stream_socket { read write getattr connectto };
allow sprd_coulomb_app phasecheckserver:unix_stream_socket { read write getattr connectto };
allow sprd_coulomb_app sprd_coulomb_app_userfaultfd:anon_inode { ioctl read create };
allow sprd_coulomb_app sysfs:file { read open };
type_transition sprd_coulomb_app sprd_coulomb_app:anon_inode sprd_coulomb_app_userfaultfd "[userfaultfd]";
type_transition sprd_coulomb_app tmpfs:file appdomain_tmpfs;
