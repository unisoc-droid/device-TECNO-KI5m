# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type midtest_app, appdomain, domain, mlstrustedsubject;
type midtest_app_userfaultfd;

allow midtest_app accessibility_service:service_manager find;
allow midtest_app activity_service:service_manager find;
allow midtest_app adbd:unix_stream_socket connectto;
allow midtest_app app_api_service:service_manager find;
allow midtest_app appdomain_tmpfs:file { read write getattr map execute };
allow midtest_app appops_service:service_manager find;
allow midtest_app ashmem_device:chr_file execute;
allow midtest_app audio_service:service_manager find;
allow midtest_app audioserver_service:service_manager find;
allow midtest_app batterystats_service:service_manager find;
allow midtest_app binder_device:chr_file { ioctl read write open };
allow midtest_app block_device:dir { open search };
allow midtest_app bluetooth_manager_service:service_manager find;
allow midtest_app bootcheckbox_exec:file { read getattr execute open execute_no_trans };
allow midtest_app cameraserver_service:service_manager find;
allow midtest_app connectivity_service:service_manager find;
allow midtest_app content_service:service_manager find;
allow midtest_app display_service:service_manager find;
allow midtest_app drmserver_service:service_manager find;
allow midtest_app fingerprintd_data_file:dir { open search };
allow midtest_app fingerprintd_data_file:file { read write open };
allow midtest_app fm_device:chr_file { ioctl read write open };
allow midtest_app gnss_file:dir { read write create open add_name remove_name search };
allow midtest_app gnss_file:file { read write create getattr setattr append unlink open };
allow midtest_app gpsd:unix_stream_socket { read write getattr sendto connectto };
allow midtest_app gpuservice:binder call;
allow midtest_app graphicsstats_service:service_manager find;
allow midtest_app hal_extRadio_hwservice:hwservice_manager find;
allow midtest_app init:unix_stream_socket connectto;
allow midtest_app input_method_service:service_manager find;
allow midtest_app mediaextractor_service:service_manager find;
allow midtest_app mediametrics_service:service_manager find;
allow midtest_app mediaserver_service:service_manager find;
allow midtest_app midtest_app:binder call;
allow midtest_app midtest_app:process execmem;
allow midtest_app midtest_app_userfaultfd:anon_inode { ioctl read create };
allow midtest_app mnt_expand_file:dir getattr;
allow midtest_app mnt_media_rw_file:dir { read open search };
allow midtest_app mnt_sdcard_file:lnk_file read;
allow midtest_app mount_service:service_manager find;
allow midtest_app network_management_service:service_manager find;
allow midtest_app nfc_service:service_manager find;
allow midtest_app notification_service:service_manager find;
allow midtest_app permission_service:service_manager find;
allow midtest_app phasecheckserver:unix_stream_socket connectto;
allow midtest_app power_service:service_manager find;
allow midtest_app proc:file { read getattr open };
allow midtest_app proc_tp_dev:file { read getattr open };
allow midtest_app prod_file:dir { read write getattr setattr open add_name remove_name search };
allow midtest_app prod_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow midtest_app prod_file:lnk_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow midtest_app property_socket:sock_file write;
allow midtest_app radio_service:service_manager find;
allow midtest_app rild:binder call;
allow midtest_app rild:unix_stream_socket connectto;
allow midtest_app servicemanager:service_manager list;
allow midtest_app shell_data_file:dir { read open search };
allow midtest_app shell_data_file:file { read getattr open };
allow midtest_app surfaceflinger_service:service_manager find;
allow midtest_app sysfs:dir search;
allow midtest_app sysfs:file { read getattr open };
allow midtest_app sysfs_camera_name:file { read getattr open };
allow midtest_app sysfs_extcon_hostenable_file:file { read getattr open };
allow midtest_app sysfs_hwinfo_file:dir { read open search };
allow midtest_app sysfs_hwinfo_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow midtest_app sysfs_leds:dir search;
allow midtest_app sysfs_power:dir search;
allow midtest_app sysfs_power:file { read write getattr open };
allow midtest_app sysfs_sensor:file { write getattr setattr open };
allow midtest_app sysfs_transsion_backlight_midtest:file { ioctl read write getattr lock append map open watch watch_reads };
allow midtest_app sysfs_transsion_leds:dir { read open search };
allow midtest_app sysfs_transsion_leds:file { read write getattr open };
allow midtest_app system_app_data_file:dir { read write create getattr setattr open add_name remove_name search };
allow midtest_app system_app_data_file:file { read write create getattr setattr append map unlink rename open };
allow midtest_app system_data_file:dir { getattr search };
allow midtest_app system_data_file:dir { read open add_name };
allow midtest_app system_data_file:lnk_file { read getattr };
allow midtest_app system_prop:property_service set;
allow midtest_app teetz_device:chr_file { ioctl read write open };
allow midtest_app textservices_service:service_manager find;
allow midtest_app tmpfs:file { read execute };
allow midtest_app user_profile_data_file:file { read getattr open };
allow midtest_app user_service:service_manager find;
allow midtest_app vendor_camera_prop:file { read getattr map open };
allow midtest_app vendor_camera_prop:file { read getattr open };
allow midtest_app vendor_default_prop:file { read getattr map open };
allow midtest_app vendor_file:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow midtest_app wcnd:unix_stream_socket { read write connectto };
allow midtest_app wifi_service:service_manager find;
allow midtest_app zygote:fd use;
type_transition midtest_app midtest_app:anon_inode midtest_app_userfaultfd "[userfaultfd]";
type_transition midtest_app tmpfs:file appdomain_tmpfs;
