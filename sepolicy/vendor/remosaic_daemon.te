# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type remosaic_daemon, domain;
type remosaic_daemon_exec, exec_type, file_type, vendor_file_type;

allow remosaic_daemon hal_camera_default:binder transfer;
allow remosaic_daemon hal_camera_default:fd use;
allow remosaic_daemon ion_device:chr_file { ioctl read open };
allow remosaic_daemon remosaic_daemon_exec:file { read getattr map execute open entrypoint };
allow remosaic_daemon remosaic_daemon_service:service_manager add;
allow remosaic_daemon vendor_camera_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow remosaic_daemon vendor_camera_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow remosaic_daemon vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow remosaic_daemon vndservicemanager:binder { call transfer };
