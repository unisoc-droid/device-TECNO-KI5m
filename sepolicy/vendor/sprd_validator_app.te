# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type sprd_validator_app, appdomain, domain, mlstrustedsubject;
type sprd_validator_app_userfaultfd;

allow sprd_validator_app accessibility_service:service_manager find;
allow sprd_validator_app activity_service:service_manager find;
allow sprd_validator_app app_api_service:service_manager find;
allow sprd_validator_app appdomain_tmpfs:file { read write getattr map execute };
allow sprd_validator_app appops_service:service_manager find;
allow sprd_validator_app audio_service:service_manager find;
allow sprd_validator_app audioserver_service:service_manager find;
allow sprd_validator_app batterystats_service:service_manager find;
allow sprd_validator_app bluetooth_manager_service:service_manager find;
allow sprd_validator_app cameraserver_service:service_manager find;
allow sprd_validator_app connectivity_service:service_manager find;
allow sprd_validator_app content_service:service_manager find;
allow sprd_validator_app display_service:service_manager find;
allow sprd_validator_app drmserver_service:service_manager find;
allow sprd_validator_app graphicsstats_service:service_manager find;
allow sprd_validator_app hal_extRadio_hwservice:hwservice_manager find;
allow sprd_validator_app input_method_service:service_manager find;
allow sprd_validator_app mediaextractor_service:service_manager find;
allow sprd_validator_app mediametrics_service:service_manager find;
allow sprd_validator_app mediaserver_service:service_manager find;
allow sprd_validator_app mount_service:service_manager find;
allow sprd_validator_app network_management_service:service_manager find;
allow sprd_validator_app notification_service:service_manager find;
allow sprd_validator_app permission_service:service_manager find;
allow sprd_validator_app power_service:service_manager find;
allow sprd_validator_app radio_service:service_manager find;
allow sprd_validator_app sprd_validator_app_userfaultfd:anon_inode { ioctl read create };
allow sprd_validator_app surfaceflinger_service:service_manager find;
allow sprd_validator_app system_app_data_file:dir { write getattr add_name search };
allow sprd_validator_app textservices_service:service_manager find;
allow sprd_validator_app user_service:service_manager find;
allow sprd_validator_app wifi_service:service_manager find;
type_transition sprd_validator_app sprd_validator_app:anon_inode sprd_validator_app_userfaultfd "[userfaultfd]";
type_transition sprd_validator_app tmpfs:file appdomain_tmpfs;
