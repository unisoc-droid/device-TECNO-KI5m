# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type qemu_props, domain;
type qemu_props_exec, exec_type, file_type, vendor_file_type;

allow qemu_props init:unix_stream_socket connectto;
allow qemu_props property_socket:sock_file write;
allow qemu_props qemu_props_exec:file { read getattr map execute open entrypoint };
