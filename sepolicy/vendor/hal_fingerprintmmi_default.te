# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type hal_fingerprintmmi_default, domain;
type hal_fingerprintmmi_default_exec, exec_type, file_type, vendor_file_type;

allow hal_fingerprintmmi_default hal_fingerprintmmi_default_exec:file { read getattr map execute open entrypoint };
allow hal_fingerprintmmi_default hal_fingerprintmmi_hwservice:hwservice_manager { add find };
allow hal_fingerprintmmi_default hidl_base_hwservice:hwservice_manager add;
allow hal_fingerprintmmi_default hwservicemanager:binder { call transfer };
allow hal_fingerprintmmi_default hwservicemanager_prop:file { read getattr map open };
