allow sprd_logmanager_app vendor_eng_prop:property_service set;
allow sprd_logmanager_app vendor_engpc_prop:file { read getattr map open };
allow sprd_logmanager_app vendor_media_prop:file { read getattr map open };
allow sprd_logmanager_app vendor_modem_prop:file { read getattr map open };
allow sprd_logmanager_app vendor_radio_noril_prop:file { read getattr map open };
allow sprd_logmanager_app vendor_radio_prop:file { read getattr map open };
allow sprd_logmanager_app vendor_sys_prop:file { read getattr map open };
allow sprd_logmanager_app vendor_systemdebuggerd_prop:file { read getattr map open };
allow sprd_logmanager_app vendor_wcnd_prop:file { read getattr map open };
allow sprd_logmanager_app vendor_wcnd_prop:property_service set;
allow sprd_logmanager_app wcnd:unix_stream_socket { read write connectto };
allow sprd_logmanager_app wifi_service:service_manager find;
type_transition sprd_logmanager_app sprd_logmanager_app:anon_inode sprd_logmanager_app_userfaultfd "[userfaultfd]";
type_transition sprd_logmanager_app tmpfs:file appdomain_tmpfs;
