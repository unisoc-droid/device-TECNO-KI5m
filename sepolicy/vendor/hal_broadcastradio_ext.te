# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type hal_broadcastradio_ext, domain, hal_broadcastradio, hal_broadcastradio_server, halserverdomain;
type hal_broadcastradio_ext_exec, exec_type, file_type, vendor_file_type;

allow hal_broadcastradio_ext fm_device:chr_file { ioctl read write open };
allow hal_broadcastradio_ext hal_broadcastradio_ext_exec:file { read getattr map execute open entrypoint };
allow hal_broadcastradio_ext hal_extbroadcastradio_hwservice:hwservice_manager { add find };
allow hal_broadcastradio_ext prod_file:dir search;
allow hal_broadcastradio_ext system_server:binder call;
