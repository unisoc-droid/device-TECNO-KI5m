# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type pnpmgr, domain, hal_power_client, halclientdomain;
type pnpmgr_device, dev_type;
type pnpmgr_exec, exec_type, file_type, vendor_file_type;

allow pnpmgr block_device:dir search;
allow pnpmgr cgroup:dir { read create open add_name };
allow pnpmgr cgroup:file { read write getattr };
allow pnpmgr cgroup_v2:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow pnpmgr cgroup_v2:file { ioctl read write getattr lock append map open watch watch_reads };
allow pnpmgr dm_device:blk_file getattr;
allow pnpmgr hwservicemanager:binder { call transfer };
allow pnpmgr hwservicemanager_prop:file { read getattr map open };
allow pnpmgr init:unix_stream_socket connectto;
allow pnpmgr input_device:chr_file { ioctl read write open };
allow pnpmgr input_device:dir { read write open search };
allow pnpmgr pnpmgr_device:chr_file { ioctl read write open };
allow pnpmgr pnpmgr_exec:file { read getattr map execute open entrypoint };
allow pnpmgr pnpmgr_service:service_manager { add find };
allow pnpmgr proc_cgroup:dir { ioctl read getattr lock open watch watch_reads search };
allow pnpmgr proc_cgroup:file { ioctl read write getattr lock append map open watch watch_reads };
allow pnpmgr property_socket:sock_file write;
allow pnpmgr property_socket:sock_file { read write };
allow pnpmgr sys_pnpmgr_file:dir search;
allow pnpmgr sys_pnpmgr_file:file { read write open };
allow pnpmgr sysfs_devices_block:dir { ioctl read getattr lock open watch watch_reads search };
allow pnpmgr sysfs_devices_block:file { ioctl read write getattr lock append map open watch watch_reads };
allow pnpmgr sysfs_devices_system_cpu:dir { read open };
allow pnpmgr sysfs_devices_system_cpu:file { read open };
allow pnpmgr sysfs_lowmemorykiller:file { read write open };
allow pnpmgr tmpfs:dir search;
allow pnpmgr vendor_pnpmgr_state_prop:file { read getattr map open };
allow pnpmgr vendor_pnpmgr_state_prop:property_service set;
allow pnpmgr vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow pnpmgr vndservicemanager:binder { call transfer };
