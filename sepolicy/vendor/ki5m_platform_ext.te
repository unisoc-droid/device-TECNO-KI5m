# installd
allow installd asec_apk_file:dir { read getattr open search };
allow installd asec_public_file:dir { read getattr open };
allow installd asec_public_file:file getattr;
allow installd media_rw_data_file:file { ioctl read write create setattr lock append map rename open watch watch_reads };
allow installd mnt_user_file:dir { read write create getattr append open search };
allow installd mnt_user_file:lnk_file read;
allow installd tran_proc_f2fs_defrag:file { read write getattr open };
allow installd tranfs_file:dir search;
allow installd tranfs_file:file { read write getattr open };

# isolated_app
allow isolated_app app_data_file:dir getattr;
allow isolated_app app_data_file:file getattr;
allow isolated_app app_data_file:file setattr;
allow isolated_app vendor_sys_prop:file read;

# kernel
allow kernel battery_file:dir { read write create getattr open add_name search };
allow kernel battery_file:file { read write create getattr setattr open };
allow kernel block_device:blk_file { read write };
allow kernel block_device:dir search;
allow kernel cali_save_file:dir { read write create getattr open add_name search };
allow kernel cali_save_file:file { read write create getattr setattr open };
allow kernel device:chr_file getattr;
allow kernel device:chr_file unlink;
allow kernel device:chr_file { create setattr };
allow kernel device:dir { remove_name rmdir };
allow kernel device:dir { write create add_name };
allow kernel kernel:key search;
allow kernel mmcblk_device:blk_file { read write open };
allow kernel prod_file:dir { write add_name search };
allow kernel prod_file:file { read write create getattr open };
allow kernel prod_file:file { write create open };
allow kernel self:capability mknod;
allow kernel self:system module_request;
allow kernel sensorhub_data_file:dir { read getattr open search };
allow kernel sensorhub_data_file:file { read getattr open };
allow kernel super_block_device:lnk_file relabelto;
allow kernel sysfs_wake_lock:file { read getattr open };
allow kernel system_data_file:file read;
allow kernel tmpfs:dir { read write create open add_name search };
allow kernel tmpfs:file { read write create open };
allow kernel tran_proc_f2fs_defrag:file { read write open };
allow kernel tranfs_file:dir { write open add_name search };
allow kernel tranfs_file:file { read write create append open };
allow kernel ufs_device:blk_file { read relabelto open };
allow kernel ufs_device:blk_file { read write open };
allow kernel unlabeled:file { write open };
allow kernel userdata_block_device:blk_file { read write open };
allow kernel vendor_file:file { read open };
allow kernel vendor_init:fd use;
allow kernel vold_device:blk_file { read write };

# keystore
allow keystore keystore:capability sys_nice;
allow keystore teetz_device:chr_file { ioctl read write open };
allow keystore tranfs_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow keystore tranfs_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow keystore tranfs_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow keystore tranfs_file:file { ioctl read write getattr lock append map open watch watch_reads };

# lmkd
allow lmkd appdomain:process { sigkill signal getpgid };
allow lmkd init:unix_stream_socket connectto;
allow lmkd lmkd:netlink_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow lmkd lmkd:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow lmkd lmkd:unix_stream_socket write;
allow lmkd proc_emem_trigger:file { write open };
allow lmkd proc_meminfo:dir { ioctl read getattr lock open watch watch_reads search };
allow lmkd proc_meminfo:lnk_file { ioctl read getattr lock map open watch watch_reads };
