# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type turbo_service, domain, mlstrustedsubject;
type turbo_service_exec, exec_type, file_type, vendor_file_type;

allow turbo_service fpsmgr_vendor_data_file:dir { read write create getattr setattr open add_name remove_name search };
allow turbo_service fpsmgr_vendor_data_file:file { read write create getattr setattr append unlink rename open };
allow turbo_service init:unix_stream_socket connectto;
allow turbo_service property_socket:sock_file write;
allow turbo_service sysfs_fpsmgr:dir { read open search };
allow turbo_service sysfs_fpsmgr:file { read write getattr open };
allow turbo_service sysfs_turbo:dir { read open search };
allow turbo_service sysfs_turbo:file { read write getattr open };
allow turbo_service tranfs_file:dir { read write create getattr setattr open add_name remove_name search };
allow turbo_service tranfs_file:file { read write create getattr setattr append unlink rename open };
allow turbo_service tranlog_device:chr_file { read write open };
allow turbo_service turbo_service_exec:file { read getattr map execute open entrypoint };
allow turbo_service vendor_tranlog_default_prop:file { read getattr map open };
allow turbo_service vendor_tranlog_default_prop:property_service set;
allow turbo_service vendor_turbo_cloud_prop:file { read getattr map open };
allow turbo_service vendor_turbo_cloud_prop:property_service set;
