# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type hal_drm_clearkey, domain, hal_drm, hal_drm_server, hal_graphics_composer_client, halclientdomain, halserverdomain;
type hal_drm_clearkey_exec, exec_type, file_type, vendor_file_type;

allow hal_drm_clearkey hal_drm_clearkey_exec:file { read getattr map execute open entrypoint };
allow hal_drm_clearkey mediadrm_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_drm_clearkey mediadrm_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_drm_clearkey vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_drm_clearkey vndservicemanager:binder { call transfer };
