# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type smartdump, domain, mlstrustedsubject;
type smartdump_exec, exec_type, file_type;
type smartdump_file, core_data_file_type, data_file_type, file_type;

allow smartdump activity_service:service_manager find;
allow smartdump dbinfo_service:service_manager find;
allow smartdump display_service:service_manager find;
allow smartdump gfxinfo_service:service_manager find;
allow smartdump init:dir { read getattr open search };
allow smartdump init:file { ioctl read getattr append open };
allow smartdump init:unix_stream_socket connectto;
allow smartdump input_service:service_manager find;
allow smartdump kernel:system syslog_mod;
allow smartdump logcat_exec:dir { read getattr open search };
allow smartdump logd:unix_stream_socket { read write connectto };
allow smartdump logdr_socket:sock_file write;
allow smartdump meminfo_service:service_manager find;
allow smartdump mnt_user_file:dir { read write search };
allow smartdump mnt_user_file:lnk_file read;
allow smartdump proc_buddyinfo:dir { read getattr open search };
allow smartdump proc_buddyinfo:file { ioctl read getattr append open };
allow smartdump proc_cmdline:dir { read getattr open search };
allow smartdump proc_cmdline:file { ioctl read getattr append open };
allow smartdump proc_filesystems:dir { read getattr open search };
allow smartdump proc_filesystems:file { ioctl read getattr append open };
allow smartdump proc_interrupts:dir { read getattr open search };
allow smartdump proc_interrupts:file { ioctl read getattr append open };
allow smartdump proc_kmsg:file { read getattr open };
allow smartdump proc_meminfo:dir { read getattr open search };
allow smartdump proc_meminfo:file { ioctl read getattr append open };
allow smartdump proc_misc:dir { read getattr open search };
allow smartdump proc_misc:file { ioctl read getattr append open };
allow smartdump proc_net:dir { read getattr open search };
allow smartdump proc_net:file { ioctl read getattr append open };
allow smartdump proc_net_tcp_udp:file { read open };
allow smartdump proc_pagetypeinfo:dir { read getattr open search };
allow smartdump proc_pagetypeinfo:file { ioctl read getattr append open };
allow smartdump proc_timer:dir { read getattr open search };
allow smartdump proc_timer:file { ioctl read getattr append open };
allow smartdump procstats_service:service_manager find;
allow smartdump property_socket:sock_file write;
allow smartdump rootfs:dir { read open };
allow smartdump rootfs:file { read getattr execute open execute_no_trans };
allow smartdump rootfs:lnk_file getattr;
allow smartdump sdcardfs:dir { read write create setattr rename open add_name remove_name reparent search rmdir };
allow smartdump sdcardfs:file { read write create getattr setattr append unlink rename open };
allow smartdump servicemanager:binder call;
allow smartdump servicemanager:dir { read getattr open search };
allow smartdump servicemanager:file { read open };
allow smartdump servicemanager:lnk_file { read getattr };
allow smartdump servicemanager:netlink_selinux_socket getattr;
allow smartdump smartdump:capability { chown fowner sys_admin };
allow smartdump smartdump:capability2 { syslog block_suspend };
allow smartdump storage_file:dir { read getattr search };
allow smartdump storage_file:lnk_file read;
allow smartdump surfaceflinger:binder { call transfer };
allow smartdump surfaceflinger:dir { read getattr open search };
allow smartdump surfaceflinger:fd use;
allow smartdump surfaceflinger:file { read open };
allow smartdump surfaceflinger:lnk_file { read getattr };
allow smartdump surfaceflinger_service:service_manager find;
allow smartdump system_file:dir { ioctl read getattr lock open watch watch_reads search };
allow smartdump system_server:binder call;
allow smartdump system_server:dir { read getattr open search };
allow smartdump system_server:file { read open };
allow smartdump system_server:lnk_file { read getattr };
allow smartdump window_service:service_manager find;
