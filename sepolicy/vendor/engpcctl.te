# Generated from stock TECNO KI5m V218 /vendor/etc/selinux.
# _31_0 suffixes removed; entries already provided by AOSP/LineageOS
# policy are omitted.

type engpcctl, domain;
type engpcctl_exec, exec_type, file_type, vendor_file_type;

allow engpcctl engpcctl_exec:file { read getattr map execute open entrypoint };
allow engpcctl prod_file:dir { read write open add_name remove_name search };
allow engpcctl prod_file:file { ioctl read write create getattr setattr lock append map unlink open watch watch_reads };
allow engpcctl sysfs:file { ioctl read write open };
